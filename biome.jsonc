{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["./conventions/biome.base.jsonc"],
  "overrides": [
    {
      // filename intentionally describes the module's theme rather than matching a single export
      "includes": ["readme-src/SectionHeadings.tsx"],
      "linter": {
        "rules": { "style": { "useFilenamingConvention": "off" } }
      }
    }
  ],
  "files": {
    "includes": [
      "**",
      "!!conventions",
      "!!**/coverage",
      "!**/node_modules",
      // generated by .github/workflows/generate-github-stats.yml
      "!github-*.svg",
      // Generated by `pnpm build` from readme-src/. A fix here would be undone by the next build.
      "!!README.md"
    ]
  }
}
