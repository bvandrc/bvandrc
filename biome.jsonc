{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["./conventions/biome.base.json"],
  "overrides": [
    {
      // filename intentionally describes the module's theme rather than matching a single export
      "includes": ["readme-src/SectionHeadings.tsx"],
      "linter": {
        "rules": { "style": { "useFilenamingConvention": "off" } }
      }
    }
  ],
  "files": {
    "includes": [
      "**",
      // generated by .github/workflows/generate-github-stats.yml
      "!github-*.svg"
    ]
  }
}
